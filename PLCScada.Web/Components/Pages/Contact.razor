@page "/contact"
<PageTitle>联系我们 · PLCScada</PageTitle>
<PageHeading Section="CONTACT" title="联系我们" Description="如需了解更多信息，欢迎通过以下方式与我们联系。" />

<section class="contact-page" aria-labelledby="contact-company">
    <div class="contact-card">
        <div class="contact-card-accent" aria-hidden="true"></div>
        <div class="contact-card-content">
            <div class="contact-overline"><span></span> CONTACT INFORMATION</div>
            <h2 id="contact-company">布拉捷精密科技（苏州）有限公司</h2>
            <p class="contact-intro">感谢您关注我们，欢迎随时联系。</p>

            <div class="contact-details">
                <div class="contact-detail">
                    <div class="contact-icon"><MudIcon Icon="@Icons.Material.Outlined.PersonOutline" /></div>
                    <div class="contact-copy">
                        <span class="contact-label">联系人</span>
                        <strong>张先生</strong>
                    </div>
                </div>
                <div class="contact-detail contact-phone">
                    <div class="contact-icon"><MudIcon Icon="@Icons.Material.Outlined.Phone" /></div>
                    <div class="contact-copy">
                        <span class="contact-label">联系电话</span>
                        <a href="tel:18550969605" aria-label="拨打电话 185 5096 9605">185 5096 9605</a>
                    </div>
                    <a class="contact-call" href="tel:18550969605" aria-label="拨打电话">
                        <span>拨打电话</span>
                        <MudIcon Icon="@Icons.Material.Outlined.ArrowOutward" Size="Size.Small" />
                    </a>
                </div>
            </div>
        </div>
        <div class="contact-card-index" aria-hidden="true">01 <span>/</span> 01</div>
    </div>
</section>
