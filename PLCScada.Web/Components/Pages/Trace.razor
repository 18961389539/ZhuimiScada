        => await Dialogs.ShowAsync<SnapshotRecordDialog>(
            "快照详情",
            new DialogParameters<SnapshotRecordDialog> { { x => x.Record, record } },
            new() { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true });

    // 结论解析：判定点位值为 1 → OK，2 → NG，其余 → 待判定
    private static (string Text, Color Color) Verdict(string? json)
    {
        foreach (var item in Parse(json))
        {
            if (!item.Name.Contains("判定")) continue;
            return item.Value.Trim() switch
            {
                "1" => ("OK", Color.Success),
                "2" => ("NG", Color.Error),
                _ => ("待判定", Color.Default)
            };
        }
        return ("—", Color.Default);
    }

    private static string VerdictText(string? json) => Verdict(json).Text;

    private static Color VerdictColor(string? json) => Verdict(json).Color;

    private static string Summary(string? json)
    {
        var parts = Parse(json)
            .Where(x => !x.Name.Contains("判定") && !string.IsNullOrWhiteSpace(x.Value))
            .Take(2)
            .Select(x => $"{x.Name} {x.Value}");
        return string.Join(" / ", parts);
    }

    private static string AllValues(string? json)
        => string.Join("; ", Parse(json).Select(x => $"{x.Name}={x.Value}"));

    private static IReadOnlyList<SnapshotValueItem> Parse(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return [];
        try
        {
            return System.Text.Json.JsonSerializer
                .Deserialize<List<SnapshotValueItem>>(json) ?? [];
        }
        catch (System.Text.Json.JsonException)
        {
            return [];
        }
    }

    private async Task OnSnapSearchChangedAsync(string _)
    {
        _snapPage = 1;
        await LoadSnapshotsAsync();
    }

    private async Task OnRangeChangedAsync(int days)
    {
        _rangeDays = days;
        _snapPage = 1;
        await LoadSnapshotsAsync();
    }

    private async Task OnSnapPageChangedAsync(int page)
    {
        if (page == _snapPage) return;
        _snapPage = page;
        await LoadSnapshotsAsync();
    }

    private async Task OnSnapPageSizeChangedAsync(int size)
    {
        _snapPageSize = size is 100 or 200 ? size : 50;
        _snapPage = 1;
        await LoadSnapshotsAsync();
    }

    /// <summary>采集项行（页面编辑态，独立于实体以免追踪干扰）。</summary>
    private sealed class PointRow
    {
        public required Guid TagId { get; init; }
        public required string Name { get; init; }
        public required TagDataType DataType { get; init; }
        public string? Alias { get; set; }
        public string? Unit { get; set; }
        public int Decimals { get; set; }
        public bool Required { get; set; }
    }
