@page "/recipes"
@inject RecipeService RecipesService
@inject DeviceService DevicesService
@inject IDialogService Dialogs
@inject ISnackbar Toast
@inject PageUiState PageState

<PageTitle>配方管理 · PLCScada</PageTitle>
<PageHeading Section="RECIPES" title="配方管理" Description="维护测试参数组合，按配方保存数值与开关设定。" />

<MudAlert Severity="Severity.Info" Dense Class="mb-4">
    配方保存在 SCADA 本地。下发前必须预览目标值并手动确认；系统会读回校验，失败时尝试恢复原值。
</MudAlert>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else
{
    <MudPaper Outlined Elevation="0" Class="table-panel recipe-table-panel">
        <MudTable Items="_recipes" Filter="Filter" Hover Elevation="0" Breakpoint="Breakpoint.Md">
            <ToolBarContent>
                <MudText Typo="Typo.body2">本地配方 · @_recipes.Count</MudText>
                <MudSpacer />
                <MudSelect T="Guid?" @bind-Value="PageState.RecipesDeviceId" Label="设备筛选"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="search-field mr-3">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">全部设备</MudSelectItem>
                    @foreach (var device in _devices)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)device.Id)">@device.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" @bind-Value="PageState.RecipesSearch" Immediate
                              Placeholder="搜索配方、说明或 Tag"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="search-field" />
                <MudButton Variant="Variant.Outlined" Color="Color.Info"
                           StartIcon="@Icons.Material.Outlined.CompareArrows"
                           OnClick="CompareWithDeviceAsync">
                    设备比对
                </MudButton>
                <a class="recipe-import-button" href="@GetBundleExportDataUrl()"
                   download="PLCScada-Recipes.json" title="导出全部配方为单个 JSON 包"
                   @onclick="OnExportAllClickedAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Small" />
                    导出全部
                </a>
                <label for="recipe-import" class="recipe-import-button">
                    <MudIcon Icon="@Icons.Material.Outlined.FileUpload" Size="Size.Small" />
                    导入配方 / 包
                </label>
                <InputFile id="recipe-import" class="recipe-import-input" style="display: none;"
                           accept=".json,application/json" OnChange="ImportAsync" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.Add" OnClick="() => EditAsync(null)">
                    新增配方
                </MudButton>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>配方与参数摘要</MudTh>
                <MudTh>设定项</MudTh>
                <MudTh>最后修改</MudTh>
                <MudTh>操作</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="配方与参数摘要">
                    <strong>@context.Name</strong>
                    <small class="cell-secondary">设备：@GetDeviceName(context.DeviceId)</small>
                    <small class="cell-secondary">
                        版本 v@(context.Revision) · 最近下发
                        @(context.LastAppliedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "从未")
                    </small>
                    @if (!string.IsNullOrWhiteSpace(context.Description))
                    {
                        <small class="cell-secondary">@context.Description</small>
                    }
                    @if (!string.IsNullOrWhiteSpace(context.ChangeNote))
                    {
                        <small class="cell-secondary">最近变更：@context.ChangeNote</small>
                    }
                    <div class="recipe-table-preview">
                        @foreach (var parameter in context.Parameters.Take(2))
                        {
                            <span>
                                @parameter.Tag?.Name：
                                @(FormatParameterValue(parameter))@(GetUnitSuffix(parameter))
                            </span>
                        }
                        @if (context.Parameters.Count > 2)
                        {
                            <span>另有 @(context.Parameters.Count - 2) 项</span>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="设定项">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                        @context.Parameters.Count 项
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="最后修改" Class="mono">
                    @context.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </MudTd>
                <MudTd DataLabel="操作">
                    <div class="row-actions">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                       title="编辑配方" aria-label="@($"编辑{context.Name}")"
                                       OnClick="@(() => EditAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Outlined.History" Size="Size.Small"
                                       title="查看版本历史" aria-label="@($"查看{context.Name}的版本历史")"
                                       OnClick="@(() => HistoryAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Outlined.ReceiptLong" Size="Size.Small"
                                       title="查看下发记录" aria-label="@($"查看{context.Name}的下发记录")"
                                       OnClick="@(() => ApplyHistoryAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small"
                                       title="复制配方" aria-label="@($"复制{context.Name}")"
                                       OnClick="@(() => DuplicateAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Publish" Size="Size.Small"
                                       title="预览并下发配方"
                                       aria-label="@($"预览并下发{context.Name}")"
                                       Disabled="@(context.DeviceId is null)"
                                       OnClick="@(() => ApplyAsync(context))" />
                        @if (CanExport(context))
                        {
                            <a class="recipe-export-button" href="@GetExportDataUrl(context)"
                               download="@GetExportFileName(context)" title="导出 JSON 配方"
                               aria-label="@($"导出{context.Name}")">
                                <MudIcon Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Small" />
                            </a>
                        }
                        else
                        {
                            <MudTooltip Text="设备或参数 Tag 已失效，无法导出">
                                <MudIconButton Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Small"
                                               Disabled="true" aria-label="@($"无法导出{context.Name}")" />
                            </MudTooltip>
                        }
                        <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error"
                                       Size="Size.Small" title="删除本地配方"
                                       aria-label="@($"删除{context.Name}")"
                                       OnClick="@(() => DeleteAsync(context))" />
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-8">没有符合条件的配方。可添加启用的读写数值寄存器或 Bool/Coil Tag。</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager RowsPerPageString="每页数量" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}

@code {
    private IReadOnlyList<Recipe> _recipes = [];
    private IReadOnlyList<Device> _devices = [];
    private string? _error;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        _loading = true;
        try
        {
            _recipes = await RecipesService.GetAllAsync();
            _devices = await DevicesService.GetAllAsync();
            if (PageState.RecipesDeviceId is Guid deviceId && _devices.All(device => device.Id != deviceId))
                PageState.RecipesDeviceId = null;
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private bool Filter(Recipe recipe)
        => RecipeListFilter.Matches(recipe, PageState.RecipesDeviceId, PageState.RecipesSearch, GetDeviceName(recipe.DeviceId));

    private string GetDeviceName(Guid? deviceId)
        => deviceId is Guid id
            ? _devices.FirstOrDefault(device => device.Id == id)?.Name ?? "设备不存在"
            : "未指定设备";

    private string GetExportDataUrl(Recipe recipe)
    {
        var json = RecipesService.ExportJson(recipe, GetDeviceName(recipe.DeviceId));
        var encoded = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));
        return $"data:application/json;base64,{encoded}";
    }

    private bool CanExport(Recipe recipe)
        => recipe.DeviceId is Guid deviceId &&
           _devices.Any(device => device.Id == deviceId) &&
           recipe.Parameters.Count > 0 &&
           recipe.Parameters.All(parameter =>
               parameter.Tag is { } tag && tag.DeviceId == deviceId);

    private static string GetExportFileName(Recipe recipe)
    {
        var invalidCharacters = Path.GetInvalidFileNameChars().ToHashSet();
        var safeName = new string(recipe.Name.Select(character =>
            invalidCharacters.Contains(character) ? '_' : character).ToArray());
        return $"{safeName}.recipe.json";
    }

    private static string FormatParameterValue(RecipeParameter parameter)
        => parameter.Tag?.DataType == TagDataType.Bool
            ? parameter.BooleanValue switch { true => "开", false => "关", null => "—" }
            : parameter.EngineeringValue?.ToString("0.###") ?? "—";

    private static string GetUnitSuffix(RecipeParameter parameter)
        => parameter.Tag?.DataType == TagDataType.Bool ? "" : parameter.Tag?.Unit ?? "";

    private async Task EditAsync(Recipe? recipe)
    {
        var dialog = await Dialogs.ShowAsync<RecipeDialog>(
            recipe is null ? "新增配方" : $"编辑配方 · {recipe.Name}",
            new DialogParameters<RecipeDialog>
            {
                { x => x.Item, recipe },
                { x => x.InitialDeviceId, recipe is null ? PageState.RecipesDeviceId : null }
            },
            new() { FullWidth = true, MaxWidth = MaxWidth.Large, CloseButton = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Toast.Add(recipe is null ? "本地配方已新增" : "本地配方已更新", Severity.Success);
            await RefreshAsync();
        }
    }

    private async Task CompareWithDeviceAsync()
    {
        await Dialogs.ShowAsync<RecipeMatchDialog>(
            "配方识别 · 与设备比对",
            new DialogParameters<RecipeMatchDialog> { { x => x.InitialDeviceId, PageState.RecipesDeviceId } },
            new() { FullWidth = true, MaxWidth = MaxWidth.Large, CloseButton = true });
    }

    private async Task HistoryAsync(Recipe recipe)
    {
        var dialog = await Dialogs.ShowAsync<RecipeHistoryDialog>(
            $"版本历史 · {recipe.Name}",
            new DialogParameters<RecipeHistoryDialog>
            {
                { x => x.RecipeId, recipe.Id },
                { x => x.CurrentRevision, recipe.Revision }
            },
            new() { FullWidth = true, MaxWidth = MaxWidth.Large, CloseButton = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            if (result.Data is int revision)
                Toast.Add($"已从历史恢复为新版本 v{revision}", Severity.Success);
            await RefreshAsync();
        }
    }

    private async Task ApplyHistoryAsync(Recipe recipe)
    {
        await Dialogs.ShowAsync<RecipeApplyHistoryDialog>(
            $"下发记录 · {recipe.Name}",
            new DialogParameters<RecipeApplyHistoryDialog>
            {
                { x => x.RecipeId, recipe.Id },
                { x => x.RecipeName, recipe.Name }
            },
            new() { FullWidth = true, MaxWidth = MaxWidth.Large, CloseButton = true });
    }

    private async Task DeleteAsync(Recipe recipe)
    {
        if (await Dialogs.ShowMessageBox(
                "删除本地配方",
                $"确定删除“{recipe.Name}”吗？这只会删除 SCADA 中保存的配方模板，不会修改 PLC 或 Tag。",
                yesText: "删除配方", cancelText: "取消") != true)
            return;

        try
        {
            await RecipesService.DeleteAsync(recipe.Id);
            Toast.Add($"本地配方“{recipe.Name}”已删除", Severity.Success);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Toast.Add($"删除配方失败：{ex.Message}", Severity.Error);
        }
    }

    private async Task ApplyAsync(Recipe recipe)
    {
        var dialog = await Dialogs.ShowAsync<RecipeApplyDialog>(
            $"预览并下发 · {recipe.Name}",
            new DialogParameters<RecipeApplyDialog> { { x => x.RecipeId, recipe.Id } },
            new()
            {
                FullWidth = true,
                MaxWidth = MaxWidth.Large,
                CloseButton = false,
                CloseOnEscapeKey = false,
                BackdropClick = false
            });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            if (result.Data is true)
                Toast.Add($"配方“{recipe.Name}”已下发并验证", Severity.Success);
            else
                Toast.Add($"配方“{recipe.Name}”下发未完成，请查看结果", Severity.Warning);
            await RefreshAsync();
        }
    }

    private async Task DuplicateAsync(Recipe recipe)
    {
        try
        {
            await RecipesService.DuplicateAsync(recipe.Id);
            Toast.Add($"配方“{recipe.Name}”已复制", Severity.Success);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Toast.Add($"复制配方失败：{ex.Message}", Severity.Error);
        }
    }

    private string GetBundleExportDataUrl()
    {
        var deviceNames = _devices.ToDictionary(x => x.Id, x => x.Name);
        var result = RecipesService.ExportBundleJson(_recipes, deviceNames);
        return $"data:application/json;base64,{Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(result.Json))}";
    }

    private async Task OnExportAllClickedAsync()
    {
        var deviceNames = _devices.ToDictionary(x => x.Id, x => x.Name);
        var result = RecipesService.ExportBundleJson(_recipes, deviceNames);
        if (result.ExportedCount == 0)
            Toast.Add("没有可导出的配方（设备或 Tag 无效）", Severity.Warning);
        else if (result.SkippedCount > 0)
            Toast.Add($"已导出 {result.ExportedCount} 个配方；{result.SkippedCount} 个因设备或 Tag 无效未包含", Severity.Warning);
        await Task.CompletedTask;
    }

    private static bool LooksLikeRecipeBundle(string json)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            return document.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object &&
                   document.RootElement.TryGetProperty("format", out var format) &&
                   format.GetString() == "PLCScada.RecipeBundle";
        }
        catch (System.Text.Json.JsonException)
        {
            return false;
        }
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        try
        {
            await using var stream = args.File.OpenReadStream(5_000_000);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            if (LooksLikeRecipeBundle(json))
            {
                var previewDialog = await Dialogs.ShowAsync<RecipeBundlePreviewDialog>(
                    "配方包导入预览",
                    new DialogParameters<RecipeBundlePreviewDialog> { { x => x.Json, json } },
                    new() { FullWidth = true, MaxWidth = MaxWidth.Large, CloseButton = true });
                var previewResult = await previewDialog.Result;
                if (previewResult is null || previewResult.Canceled)
                    return;

                var result = await RecipesService.ImportBundleJsonAsync(json);
                if (result.FailedCount == 0)
                {
                    Toast.Add($"批量导入完成：直接导入 {result.ImportedCount} 个" +
                              (result.RenamedCount > 0 ? $"，重命名导入 {result.RenamedCount} 个" : ""),
                        Severity.Success);
                }
                else
                {
                    var details = string.Join("\n", result.Items
                        .Where(x => x.Status == "未导入")
                        .Take(10)
                        .Select(x => $"· {x.Name}：{x.Message}"));
                    await Dialogs.ShowMessageBox(
                        "配方包导入结果",
                        $"直接导入 {result.ImportedCount} 个，重命名导入 {result.RenamedCount} 个，未导入 {result.FailedCount} 个：\n{details}" +
                        (result.FailedCount > 10 ? "\n（仅显示前 10 条）" : ""),
                        yesText: "知道了");
                }
            }
            else
            {
                var id = await RecipesService.ImportJsonAsync(json);
                var imported = (await RecipesService.GetAllAsync()).Single(x => x.Id == id);
                Toast.Add($"配方“{imported.Name}”已导入到设备“{GetDeviceName(imported.DeviceId)}”", Severity.Success);
            }
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Toast.Add($"导入失败：{ex.Message}", Severity.Error);
        }
    }
}
